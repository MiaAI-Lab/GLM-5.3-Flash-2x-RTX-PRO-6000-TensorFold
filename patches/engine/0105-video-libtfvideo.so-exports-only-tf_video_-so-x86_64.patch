From b07a492a6bac35ba1d6a6e5cb77d14d521ebd491 Mon Sep 17 00:00:00 2001
From: Scott Biggart <swbiggart@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:34:33 -0800
Subject: [PATCH] video: libtfvideo.so exports only tf_video_*, so FFmpeg's
 x86_64 asm links

FFmpeg's x86_64 assembly (x86asm and the inline asm in its CABAC reader) addresses tables defined in C, such as
ff_pw_* in libavcodec/x86/constants.c and ff_h264_cabac_tables, with 32-bit PC-relative relocations. Linked from the
static libav*.a into a shared library, those tables are exported and so preemptible, and the linker refuses them:
"relocation R_X86_64_PC32 cannot be used against symbol 'ff_pw_2048'; recompile with -fPIC", 5,115 times against
35 symbols, although build_ffmpeg.sh already passes --enable-pic. FFmpeg's own shared build avoids it with
-Wl,-Bsymbolic.

On ELF targets the library now links with a version script that exports the four tf_video_* symbols core/tfvideo.zig
looks up and makes every other symbol local. The tables are then bound inside the library, the PC-relative
references resolve at link time, and the library carries no text relocations. It also stops exporting FFmpeg's API
(3,525 symbols on aarch64).

check-video-exports-linux links the loader-layout stub plus a planted C table, which x86_64 inline asm reads
PC-relative, through the same version script for aarch64 and x86_64 Linux, then reads the .so: exactly the four
tf_video_* names exported, the table kept as a local symbol, no text relocations. Without the version script the
x86_64 link stops on the same R_X86_64_PC32 error and the aarch64 library exports the planted names.

The loader, its symbol lookups and refusal text, build_ffmpeg.sh and its FFmpeg pin, and Mach-O builds are unchanged.
Cross-links over FFmpeg 9.0.2 with assembly for x86_64 and aarch64 Linux, and check-video-exports-linux, pass on a
macOS host; a native Linux build and real video through it remain unchecked here.
---
 tools/zig/check_tfvideo_exports.py | 70 ++++++++++++++++++++++++++++++
 zig/build/video.zig                | 17 ++++++++
 zig/tests/tfvideo_planted.c        | 14 ++++++
 3 files changed, 101 insertions(+)
 create mode 100644 tools/zig/check_tfvideo_exports.py
 create mode 100644 zig/tests/tfvideo_planted.c

diff --git a/tools/zig/check_tfvideo_exports.py b/tools/zig/check_tfvideo_exports.py
new file mode 100644
index 000000000..c1a9d57db
--- /dev/null
+++ b/tools/zig/check_tfvideo_exports.py
@@ -0,0 +1,70 @@
+"""An ELF libtfvideo.so exports exactly the four tf_video_* functions, keeps a planted table local, has no TEXTREL."""
+import struct
+import sys
+from pathlib import Path
+
+WANT = {'tf_video_open', 'tf_video_frames', 'tf_video_close', 'tf_video_version'}
+SHT_SYMTAB, SHT_DYNAMIC, SHT_DYNSYM = 2, 6, 11
+DT_TEXTREL, DT_FLAGS, DF_TEXTREL = 22, 30, 0x4
+
+
+def sections(data: bytes) -> list[tuple]:
+    """(type, offset, size, link, entsize) for each section of a little-endian ELF64 file."""
+    if data[:4] != b'\x7fELF' or data[4] != 2 or data[5] != 1:
+        raise SystemExit('not a little-endian ELF64 file')
+    shoff, = struct.unpack_from('<Q', data, 0x28)
+    shentsize, shnum = struct.unpack_from('<HH', data, 0x3a)
+    out = []
+    for i in range(shnum):
+        _, kind, _, _, off, size, link, _, _, ent = struct.unpack_from('<IIQQQQIIQQ', data, shoff + i * shentsize)
+        out.append((kind, off, size, link, ent))
+    return out
+
+
+def symbols(data: bytes, secs: list[tuple], kind: int) -> dict[str, tuple[int, int]]:
+    """Defined symbols of the given table: name -> (binding, section index)."""
+    out = {}
+    for t, off, size, link, ent in secs:
+        if t != kind:
+            continue
+        strtab = secs[link][1]
+        for at in range(off + ent, off + size, ent):
+            name, info, _, shndx = struct.unpack_from('<IBBH', data, at)
+            if shndx:
+                end = data.index(b'\0', strtab + name)
+                out[data[strtab + name:end].decode()] = (info >> 4, shndx)
+    return out
+
+
+def textrel(data: bytes, secs: list[tuple]) -> bool:
+    """True when .dynamic has DT_TEXTREL or DF_TEXTREL in DT_FLAGS."""
+    for t, off, size, _, _ in secs:
+        if t == SHT_DYNAMIC:
+            for at in range(off, off + size, 16):
+                tag, val = struct.unpack_from('<qQ', data, at)
+                if tag == DT_TEXTREL or (tag == DT_FLAGS and val & DF_TEXTREL):
+                    return True
+    return False
+
+
+def main() -> int:
+    failed = 0
+    for arg in sys.argv[1:]:
+        data = Path(arg).read_bytes()
+        secs = sections(data)
+        exported = {n for n, (bind, _) in symbols(data, secs, SHT_DYNSYM).items() if bind in (1, 2)}
+        planted = symbols(data, secs, SHT_SYMTAB).get('tfvideo_planted_table')
+        problems = [f'exports {sorted(exported ^ WANT)} beyond or short of the four'] if exported != WANT else []
+        if planted is None or planted[0] != 0:
+            problems.append(f'the planted table is not a local symbol: {planted}')
+        if textrel(data, secs):
+            problems.append('text relocations')
+        machine = {62: 'x86_64', 183: 'aarch64'}.get(struct.unpack_from('<H', data, 0x12)[0], 'other')
+        verdict = 'FAIL' if problems else 'PASS'
+        print(f'{verdict} {machine} {arg}: {len(exported)} exported' + ''.join(f'; {p}' for p in problems))
+        failed += bool(problems)
+    return 1 if failed or len(sys.argv) < 2 else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/zig/build/video.zig b/zig/build/video.zig
index 3e33b3fae..e6752a247 100644
--- a/zig/build/video.zig
+++ b/zig/build/video.zig
@@ -15,6 +15,7 @@ pub fn steps(b: *std.Build, target: std.Build.ResolvedTarget, host_tests: *std.B
     b.step("test-video-library-host", "Video candidate order with a recording opener, without real libraries").dependOn(&run.step);
     host_tests.dependOn(&run.step);
     const cross = b.step("check-video-layout-linux", "Compile the Linux video probe and stub without execution");
+    const exports = b.step("check-video-exports-linux", "Link a planted Linux stub as `video` links; read its exports");
     inline for (.{ .aarch64, .x86_64 }) |arch| {
         const linux = b.resolveTargetQuery(.{ .cpu_arch = arch, .os_tag = .linux, .abi = .gnu });
         const probe = layoutProbe(b, linux);
@@ -25,6 +26,15 @@ pub fn steps(b: *std.Build, target: std.Build.ResolvedTarget, host_tests: *std.B
         const lib = b.addLibrary(.{ .name = "tfvideo", .linkage = .dynamic, .root_module = stub });
         _ = lib.getEmittedBin();
         cross.dependOn(&lib.step);
+        const planted = b.createModule(.{ .target = linux, .link_libc = true });
+        for ([_][]const u8{ "zig/tests/tfvideo_stub.c", "zig/tests/tfvideo_planted.c" }) |c|
+            planted.addCSourceFile(.{ .file = b.path(c), .flags = &.{ "-std=c11", "-Wall", "-Wextra", "-Werror" } });
+        const scripted = b.addLibrary(.{ .name = "tfvideo", .linkage = .dynamic, .root_module = planted });
+        scripted.link_gc_sections = false;
+        exportOnlyTfVideo(b, scripted);
+        const check = b.addSystemCommand(&.{ "python3", "tools/zig/check_tfvideo_exports.py" });
+        check.addArtifactArg(scripted);
+        exports.dependOn(&check.step);
     }
     if (b.graph.host.result.os.tag == .linux) {
         const layout = b.addSystemCommand(&.{ "python3", "tools/zig/test_tfvideo_layout.py", "--probe" });
@@ -56,6 +66,7 @@ pub fn steps(b: *std.Build, target: std.Build.ResolvedTarget, host_tests: *std.B
     }) |a| mod.addObjectFile(root.path(b, b.pathJoin(&.{ "lib", a })));
     mod.linkSystemLibrary("m", .{});
     const lib = b.addLibrary(.{ .name = "tfvideo", .linkage = .dynamic, .root_module = mod });
+    exportOnlyTfVideo(b, lib);
     step.dependOn(&b.addInstallArtifact(lib, .{ .dest_dir = .{ .override = .{ .custom = "native/lib" } } }).step);
 }
 
@@ -64,3 +75,9 @@ fn layoutProbe(b: *std.Build, target: std.Build.ResolvedTarget) *std.Build.Step.
     root.addImport("tfvideo", b.createModule(.{ .root_source_file = b.path("zig/src/core/tfvideo.zig"), .target = target, .link_libc = true }));
     return b.addExecutable(.{ .name = "tfvideo-layout", .root_module = root });
 }
+
+/// ELF exports only tf_video_*: FFmpeg's x86_64 assembly then reaches its C tables PC-relative inside the library.
+fn exportOnlyTfVideo(b: *std.Build, lib: *std.Build.Step.Compile) void {
+    if (lib.rootModuleTarget().ofmt != .elf) return;
+    lib.setVersionScript(b.addWriteFiles().add("tfvideo.map", "{ global: tf_video_*; local: *; };\n"));
+}
diff --git a/zig/tests/tfvideo_planted.c b/zig/tests/tfvideo_planted.c
new file mode 100644
index 000000000..020c77193
--- /dev/null
+++ b/zig/tests/tfvideo_planted.c
@@ -0,0 +1,14 @@
+// Planted for check-video-exports-linux: a C table that x86_64 asm reads PC-relative, as FFmpeg's assembly does.
+#include <stdint.h>
+
+const uint16_t tfvideo_planted_table[4] = {1, 2, 3, 4};
+
+uint32_t tfvideo_planted_read(void) {
+    uint32_t v;
+#if defined(__x86_64__)
+    __asm__("movzwl tfvideo_planted_table(%%rip), %0" : "=r"(v));
+#else
+    v = tfvideo_planted_table[0];
+#endif
+    return v;
+}
