     const f0 = Fingerprint.of(2, 0, .{}, 8192, true, h0, h0, hashBytes("/c"));
     try std.testing.expectEqual(@as(u32, 0), f0.kv_shard);
     try std.testing.expectEqual(@as(u32, 0), f0.kv_shard_check);
