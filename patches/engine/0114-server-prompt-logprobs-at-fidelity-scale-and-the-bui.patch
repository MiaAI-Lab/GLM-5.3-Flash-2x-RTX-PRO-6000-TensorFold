+/// row at most ``cap`` entries. Row 0 (before any token) carries no rows: its list, when given, is checked only.
+pub const PromptIds = union(enum) {
+    every: []const u32, // the one list, every position
+    rows: []const []const u32, // position p's list; rows[0] unused by the engine
+
+    pub fn len(p: PromptIds) usize {
+        return switch (p) {
+            .every => |x| x.len,
+            .rows => |x| if (x.len > 0) x[1..].len else 0,
+        };
+    }
+};
+
+pub fn promptLogprobsIds(cx: *Cx, body: Value, vocab: u32, cap: usize) errors.Refused!?PromptIds {
+    const asked = body.field("prompt_logprobs_token_ids") orelse return null;
+    if (asked != .array or asked.array.len == 0) return cx.refuse("prompt_logprobs_token_ids must be a nonempty list of token ids, or a list of per-position lists");
+    if (asked.array[0] == .array) {
+        const rows = try cx.a.alloc([]const u32, asked.array.len);
+        for (asked.array, rows) |row, *slot| {
+            if (row != .array) return cx.refuse("prompt_logprobs_token_ids must be a list of token ids, or a list of per-position lists");
+            slot.* = try idsOf(cx, row, vocab, cap);
+        }
+        return .{ .rows = rows };
+    }
+    return .{ .every = try idsOf(cx, asked, vocab, cap) };
+}
+
+fn idsOf(cx: *Cx, row: Value, vocab: u32, cap: usize) errors.Refused![]const u32 {
+    if (row.array.len > cap) return cx.fail(.request, "prompt_logprobs_token_ids carries at most {d} ids a position", .{cap});
+    const out = try cx.a.alloc(u32, row.array.len);
+    for (row.array, out) |id, *slot| {
+        const n = id.int64();
+        if (n == null or n.? < 0 or n.? >= vocab) return cx.fail(.request, "prompt_logprobs_token_ids ids must be integers in the valid range 0 to {d}", .{@as(i64, vocab) - 1});
+        slot.* = @intCast(n.?);
+    }
+    return out;
+}
+
+/// ``prompt_logprobs_format``: the entries' shape, vLLM's map (the default) or ``compact``.
+pub fn promptLogprobsFormat(cx: *Cx, body: Value) errors.Refused!?[]const u8 {
+    const asked = body.field("prompt_logprobs_format") orelse return null;
+    if (asked != .string or (asked.string.len != 0 and !std.mem.eql(u8, asked.string, "vllm") and !std.mem.eql(u8, asked.string, "compact")))
+        return cx.refuse("prompt_logprobs_format must be \"vllm\" or \"compact\", or null");
+    return if (asked.string.len == 0) null else asked.string;
+}
+
+/// ``echo``: the prompt repeated before the completion's text; a bool or null.
+pub fn echo(cx: *Cx, body: Value) errors.Refused!bool {
+    const asked = body.field("echo") orelse return false;
+    if (asked == .null) return false;
+    if (asked != .bool) return cx.refuse("echo must be a boolean or null");
+    return asked.bool;
+}
