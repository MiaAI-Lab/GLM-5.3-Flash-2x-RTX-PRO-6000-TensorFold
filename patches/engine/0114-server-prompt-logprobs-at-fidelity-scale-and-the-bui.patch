+
+/// The requested ids' entries for ``position`` in vLLM's shape; the engine's nan marks a gap in the padded row.
+fn extrasInto(srv: *Server, a: Allocator, o: *json.Object, p: api.PromptLogprobs, ids: []const u32, stride: u32, position: usize) Allocator.Error!void {
+    if (position == 0 or stride == 0 or p.stride == 0 or p.extra_logprobs.len < position * p.stride) return;
+    const row = position - 1; // the engine's rows start at prompt position 1
+    if (row >= p.rows.len) return;
+    for (0..@min(stride, p.stride)) |j| {
+        const lp = p.extra_logprobs[row * p.stride + j];
+        if (!std.math.isFinite(lp)) continue;
+        const id = ids[row * stride + j];
