+/// The prompt's logprob entries: vLLM's maps (``null``, then ``{id: {logprob, rank, decoded_token}}`` a position,
+/// the prompt token first, then the best, then the request's own ids), or ``compact`` rows. ``ids``/``stride`` are
+/// the request's padded per-position id matrix, row p - 1 for prompt position p; ``missing`` names the positions
+/// whose token has no score (the engine's nan), for the reply's ``prompt_logprobs_missing``.
+pub const Prompt = struct { value: Value, missing: []const u32 = &.{} };
+
+pub fn promptValue(srv: *Server, a: Allocator, p: api.PromptLogprobs, ids: []const u32, stride: u32, compact: bool) Allocator.Error!Prompt {
+    const rows = try a.alloc(Value, p.rows.len + 1);
+    rows[0] = if (compact) try compactRow(a, p, 0, ids, stride) else .null;
+    var missing: std.ArrayList(u32) = .empty;
