+        if (!scored) try missing.append(a, @intCast(position));
+        rows[position] = if (compact)
+            try compactRow(a, p, position, ids, stride)
+        else blk: {
+            const o = try json.newObject(a);
+            if (scored) try promptEntry(srv, a, o, r.token, r.logprob, r.rank);
