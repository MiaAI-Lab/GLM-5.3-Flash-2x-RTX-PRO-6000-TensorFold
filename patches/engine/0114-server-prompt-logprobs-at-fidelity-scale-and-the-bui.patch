+    };
+    if (r) |row| for (row.ids[0..row.count], row.logprobs[0..row.count]) |id, lp| {
+        if (id == row.token and !std.math.isNan(row.logprob)) continue;
+        try id_list.append(a, try json.intValue(a, id));
+        try lp_list.append(a, .{ .float = lp });
+    };
+    if (position > 0 and stride > 0 and p.stride > 0 and p.extra_logprobs.len >= position * p.stride) {
+        const row = position - 1;
+        for (0..@min(stride, p.stride)) |j| {
+            const lp = p.extra_logprobs[row * p.stride + j];
+            const id = ids[row * stride + j];
+            if (!std.math.isFinite(lp) or id == api.logprob_extra_none) continue;
+            try id_list.append(a, try json.intValue(a, id));
+            try lp_list.append(a, .{ .float = lp });
+        }
     }
-    return .{ .array = out };
+    try o.put(a, "ids", .{ .array = id_list.items });
+    try o.put(a, "logprobs", .{ .array = lp_list.items });
+    const actual = try json.newObject(a);
+    if (r) |row| if (!std.math.isNan(row.logprob)) {
+        try actual.put(a, "id", try json.intValue(a, row.token));
+        try actual.put(a, "logprob", .{ .float = row.logprob });
+        try actual.put(a, "rank", try json.intValue(a, row.rank));
+    };
+    try o.put(a, "actual", .{ .object = actual });
+    return .{ .object = o };
 }
 
