diff --git a/zig/kernels/cuda/logprob_rows.cuh b/zig/kernels/cuda/logprob_rows.cuh
index a50760819..ae2179697 100644
--- a/zig/kernels/cuda/logprob_rows.cuh
+++ b/zig/kernels/cuda/logprob_rows.cuh
@@ -9,8 +9,11 @@ namespace tf_logprob {
 constexpr unsigned TG = 1024;  // one block a row, as tf_logprob_rows launches it
 constexpr unsigned NSG = TG / 32;
 constexpr unsigned FULL = 0xFFFFFFFFu;
-constexpr unsigned LP_TOP = 20;
-constexpr unsigned LP_WORDS = 3 + 2 * LP_TOP;
+constexpr unsigned LP_TOP = 128;  // lanes/logprob.zig's max_top: the row words' stride is shared with the host
+constexpr unsigned LP_EXTRA = 128;  // lanes/logprob.zig's extra_max: requested ids' logprob/rank pairs a row
+constexpr unsigned LP_WORDS = 3 + 2 * LP_TOP + 2 * LP_EXTRA;
+constexpr unsigned LP_EXTRA_AT = 3 + 2 * LP_TOP;  // the first pair's word offset
+constexpr unsigned LP_NONE = 0xFFFFFFFFu;  // a gap in the row's requested ids: its logprob reads as nan
 
 // (m, s): a running max and the sum of exp(x - m) under it, merged with another part's
 __device__ __forceinline__ void lse_merge(float& m, float& s, float m2, float s2) {
@@ -29,11 +32,15 @@ __device__ __forceinline__ void lse_merge(float& m, float& s, float m2, float s2
 __device__ __forceinline__ bool better(float v, unsigned i, float bv, unsigned bi) { return v > bv || (v == bv && i < bi); }
 
 // One row: a fixed reduction tree (lane tree, then warp 0 over the warps), so a row's words never depend on timing.
-__device__ void logprob_row(const __nv_bfloat16* L, unsigned V, unsigned pick, unsigned k, bool rank, unsigned* out) {
+// EX (null: none) holds the row's requested ids, one word each at EXEX j of EXTRA_STRIDE; each gets its logprob under
+// the row's distribution and its vLLM rank; a gap or an out-of-range id writes nan and rank 0.
+__device__ void logprob_row(const __nv_bfloat16* L, unsigned V, unsigned pick, unsigned k, bool rank, unsigned* out,
+                            const unsigned* ex, unsigned extra_stride) {
     __shared__ float part_m[NSG], part_s[NSG], part_v[NSG];
     __shared__ unsigned part_i[NSG];
     __shared__ float prev_v;
     __shared__ unsigned prev_i;
+    __shared__ float lse_val;
     const unsigned t = threadIdx.x, lane = t & 31u, warp = t >> 5;
     float m = -INFINITY, s = 0.0f;
     for (unsigned i = t; i < V; i += TG) {
@@ -69,10 +76,12 @@ __device__ void logprob_row(const __nv_bfloat16* L, unsigned V, unsigned pick, u
             lse_merge(m, s, m2, s2);
         }
         if (lane == 0) {
-            out[0] = __float_as_uint(m + logf(s));
+            lse_val = m + logf(s);
+            out[0] = __float_as_uint(lse_val);
             out[1] = __float_as_uint(pick < V ? __bfloat162float(L[pick]) : NAN);
         }
     }
+    __syncthreads();  // lse_val visible to every thread for the requested ids' logprobs below
     if (rank) {
         // vLLM's rank: the entries whose logit is at or above the pick's, the pick itself included
         const float pk = pick < V ? __bfloat162float(L[pick]) : INFINITY;
@@ -92,6 +101,39 @@ __device__ void logprob_row(const __nv_bfloat16* L, unsigned V, unsigned pick, u
     } else if (t == 0) {
         out[2 + 2 * LP_TOP] = 0;
     }
+    if (ex != nullptr) {
+        // Each requested id: its logprob under the row's distribution and the entries at or above it, one reduction
+        // a id, the same fixed tree as the rank above, so the words never depend on timing.
+        const float lse = lse_val;
+        for (unsigned j = 0; j < LP_EXTRA; ++j) {
+            const unsigned id = ex[static_cast<size_t>(j) * extra_stride];
+            unsigned* slot = out + LP_EXTRA_AT + 2 * j;
+            if (id == LP_NONE || id >= V) {
+                if (t == 0) {
+                    slot[0] = 0x7FC00000u;  // quiet nan: a gap, the server omits the id
+                    slot[1] = 0;
+                }
+                continue;
+            }
+            const float v = __bfloat162float(L[id]);
+            unsigned above = 0;
+            for (unsigned i = t; i < V; i += TG) above += __bfloat162float(L[i]) >= v ? 1u : 0u;
+#pragma unroll
+            for (int off = 16; off > 0; off >>= 1) above += __shfl_down_sync(FULL, above, off);
+            if (lane == 0) part_i[warp] = above;
+            __syncthreads();
+            if (warp == 0) {
+                above = part_i[lane];
+#pragma unroll
+                for (int off = 16; off > 0; off >>= 1) above += __shfl_down_sync(FULL, above, off);
+                if (lane == 0) {
+                    slot[0] = __float_as_uint(v - lse);
+                    slot[1] = above;
+                }
+            }
+            __syncthreads();  // part_i is the selection rounds' scratch below
+        }
+    }
     for (unsigned r = 0; r < k; ++r) {
         // the best entry after the last one taken: a strict total order, so the result is exact
         const float pv = prev_v;
