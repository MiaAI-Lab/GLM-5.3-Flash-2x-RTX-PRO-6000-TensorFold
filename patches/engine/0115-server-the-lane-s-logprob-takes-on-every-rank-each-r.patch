+    const host = try gpa.alloc(u16, n_rows * most);
+    defer gpa.free(host);
+    const wide = try gpa.alloc(f32, n_rows * most);
+    defer gpa.free(wide);
+    var logits = try cuda.DeviceBuffer.alloc(gpu.d, n_rows * most * 2);
+    defer logits.free();
+    var picks = try cuda.DeviceBuffer.alloc(gpu.d, n_rows * 4);
+    defer picks.free();
+    var ids = try cuda.DeviceBuffer.alloc(gpu.d, n_rows * stride * 4);
+    defer ids.free();
+    var want_dev = try cuda.DeviceBuffer.alloc(gpu.d, n_rows * words * 4);
+    defer want_dev.free();
+    var got_dev = try cuda.DeviceBuffer.alloc(gpu.d, n_rows * words * 4);
+    defer got_dev.free();
+    var cases: usize = 0;
+    for (widths) |n| for (std.enums.values(Kind), 0..) |kind, ki| for ([_]bool{ false, true }) |odd| {
+        for (0..n_rows) |r| {
+            const row = host[r * n ..][0..n];
+            fill(kind, ki * 41 + r + n, row, wide[r * n ..][0..n]);
+            if (odd) for (row, 0..) |*h, i| {
+                if (i % 5 == 1) h.* = 0xFF80 else if (i % 13 == 3) h.* = 0x7FC0;
+            };
+        }
+        try logits.uploadAsync(0, std.mem.sliceAsBytes(host[0 .. n_rows * n]), stream.handle);
+        // a first pass names each row's best: the ids the second pass must score beside its own
+        const pick = try gpa.alloc(u32, n_rows);
+        defer gpa.free(pick);
+        for (0..n_rows) |r| pick[r] = @intCast((r * 7 + 3) % n);
+        try picks.uploadAsync(0, std.mem.sliceAsBytes(pick), stream.handle);
+        try d.logprobRows(stream, logits.ptr, n, picks.ptr, k, true, want_dev.ptr, n_rows, 0, 0);
+        try stream.synchronize();
+        var want: [n_rows * words]u32 = undefined;
+        try want_dev.download(0, std.mem.sliceAsBytes(&want));
+        const matrix = try gpa.alloc(u32, n_rows * stride);
+        defer gpa.free(matrix);
+        for (0..n_rows) |r| {
+            const row = host[r * n ..][0..n];
+            const best = want[r * words + 2 ..][0..k];
+            const at = r * stride;
+            matrix[at] = best[0];
+            matrix[at + 1] = best[1];
+            var got: usize = 2;
+            for (0..n) |i| { // two ids past the best, their values finite (a flat row's own logprobs tie, as they must)
+                const v = widen(row[i]);
+                if (v != v or v == -std.math.inf(f32)) continue;
+                if (std.mem.indexOfScalar(u32, best, @intCast(i)) != null) continue;
+                matrix[at + got] = @intCast(i);
+                got += 1;
+                if (got == 4) break;
+            }
+            try check.expect(got == 4, "row {d} of width {d}: no two finite ids past the best", .{ r, n });
+            matrix[at + 4] = none;
+            matrix[at + 5] = @intCast(n);
+        }
+        try ids.uploadAsync(0, std.mem.sliceAsBytes(matrix), stream.handle);
+        try d.logprobRows(stream, logits.ptr, n, picks.ptr, k, true, got_dev.ptr, n_rows, ids.ptr, stride);
+        try stream.synchronize();
+        var got_words: [n_rows * words]u32 = undefined;
+        try got_dev.download(0, std.mem.sliceAsBytes(&got_words));
+        for (0..n_rows) |r| {
+            const row = host[r * n ..][0..n]; // the kernel's view: bf16, widened on comparison
+            const lse: f32 = @bitCast(got_words[r * words]);
+            if (!std.math.isFinite(lse)) continue; // a NaN entry's row: its normalizer is NaN, only the ids are checked
+            const w = got_words[r * words ..][0..words];
+            for (0..stride) |j| {
+                const id = matrix[r * stride + j];
+                const lp_bits = w[lanes.logprob.extra_at + 2 * j];
+                const rank = w[lanes.logprob.extra_at + 2 * j + 1];
+                if (j >= 4) { // the gap and the id past the vocabulary: no rank, either quiet or plain nan
+                    try check.expect(rank == 0 and (lp_bits == 0x7FC00000 or lp_bits == 0xFFC00000), "row {d} slot {d}: a gap reads rank 0 and nan, got {x}/{d}", .{ r, j, lp_bits, rank });
+                    continue;
+                }
+                const v = widen(row[id]);
+                var count: u32 = 0;
+                for (row, 0..) |x, q| count += if (widen(x) >= v and !(widen(x) == v and q > id)) 1 else 0;
+                const want_lp: f32 = v - lse;
+                try check.expect(lp_bits == @as(u32, @bitCast(want_lp)), "row {d} slot {d} id {d}: logprob {x} not the host's {x}", .{ r, j, id, lp_bits, @as(u32, @bitCast(want_lp)) });
+                try check.expect(rank == count, "row {d} slot {d} id {d}: rank {d} not the host's {d}", .{ r, j, id, rank, count });
+                if (j < 2) { // inside the best: the row's own logprob for that id, the best word less the normalizer
+                    const at: usize = std.mem.indexOfScalarPos(u32, want[r * words + 2 ..][0..k], 0, id).?;
+                    const best: f32 = @bitCast(want[r * words + 2 + lanes.logprob.max_top + at]);
+                    try check.expect(@as(f32, @bitCast(lp_bits)) == best - lse, "row {d} slot {d}: the best entry's logprob differs", .{ r, j });
+                }
+            }
+            cases += 1;
+        }
+    };
+    check.pass("extras: {d} rows' requested ids score their own logprob and rank", .{cases});
+}
