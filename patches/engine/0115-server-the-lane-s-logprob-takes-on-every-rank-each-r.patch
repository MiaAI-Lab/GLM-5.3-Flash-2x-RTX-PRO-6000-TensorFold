 zig/src/server/server.zig            |  56 ++++++++-
 zig/tests/cuda/glm_lanes_tests.zig   | 167 +++++++++++++++++++++++++--
 zig/tests/cuda/main.zig              |   4 +
 zig/tests/cuda/sample_tests.zig      | 112 +++++++++++++++++-
 8 files changed, 450 insertions(+), 44 deletions(-)

diff --git a/zig/kernels/cuda/logprob_rows.cuh b/zig/kernels/cuda/logprob_rows.cuh
index ae2179697..2fa64b38c 100644
--- a/zig/kernels/cuda/logprob_rows.cuh
+++ b/zig/kernels/cuda/logprob_rows.cuh
@@ -32,7 +32,7 @@ __device__ __forceinline__ void lse_merge(float& m, float& s, float m2, float s2
 __device__ __forceinline__ bool better(float v, unsigned i, float bv, unsigned bi) { return v > bv || (v == bv && i < bi); }
 
 // One row: a fixed reduction tree (lane tree, then warp 0 over the warps), so a row's words never depend on timing.
-// EX (null: none) holds the row's requested ids, one word each at EXEX j of EXTRA_STRIDE; each gets its logprob under
+// EX (null: none) holds the row's requested ids, `extra_stride` of them, one word each; each gets its logprob under
 // the row's distribution and its vLLM rank; a gap or an out-of-range id writes nan and rank 0.
 __device__ void logprob_row(const __nv_bfloat16* L, unsigned V, unsigned pick, unsigned k, bool rank, unsigned* out,
                             const unsigned* ex, unsigned extra_stride) {
@@ -102,11 +102,12 @@ __device__ void logprob_row(const __nv_bfloat16* L, unsigned V, unsigned pick, u
         out[2 + 2 * LP_TOP] = 0;
     }
     if (ex != nullptr) {
-        // Each requested id: its logprob under the row's distribution and the entries at or above it, one reduction
-        // a id, the same fixed tree as the rank above, so the words never depend on timing.
+        // Each of the row's `extra_stride` requested ids: its logprob under the row's distribution and the entries at
+        // or above it, one reduction a id, the same fixed tree as the rank above, so the words never depend on
+        // timing; the row words' remaining slots read as none, their ids past the row's width.
         const float lse = lse_val;
         for (unsigned j = 0; j < LP_EXTRA; ++j) {
-            const unsigned id = ex[static_cast<size_t>(j) * extra_stride];
+            const unsigned id = j < extra_stride ? ex[j] : LP_NONE;
             unsigned* slot = out + LP_EXTRA_AT + 2 * j;
             if (id == LP_NONE || id >= V) {
                 if (t == 0) {
@@ -116,19 +117,35 @@ __device__ void logprob_row(const __nv_bfloat16* L, unsigned V, unsigned pick, u
                 continue;
             }
             const float v = __bfloat162float(L[id]);
-            unsigned above = 0;
-            for (unsigned i = t; i < V; i += TG) above += __bfloat162float(L[i]) >= v ? 1u : 0u;
+            // the id's rank as the best list below orders them (value desc, ties by the lower id first, the id
+            // itself counted): the entries at or above it less the equal-valued ones after it
+            unsigned above = 0, after = 0;
+            for (unsigned i = t; i < V; i += TG) {
+                const float x = __bfloat162float(L[i]);
+                above += x >= v ? 1u : 0u;
+                after += (x == v && i > id) ? 1u : 0u;
+            }
 #pragma unroll
-            for (int off = 16; off > 0; off >>= 1) above += __shfl_down_sync(FULL, above, off);
-            if (lane == 0) part_i[warp] = above;
+            for (int off = 16; off > 0; off >>= 1) {
+                above += __shfl_down_sync(FULL, above, off);
+                after += __shfl_down_sync(FULL, after, off);
+            }
+            if (lane == 0) {
+                part_i[warp] = above;
+                part_s[warp] = __int_as_float((int)after);  // the lse's scratch, free since it was read
+            }
             __syncthreads();
             if (warp == 0) {
                 above = part_i[lane];
+                unsigned after = (unsigned)__float_as_int(part_s[lane]);
 #pragma unroll
-                for (int off = 16; off > 0; off >>= 1) above += __shfl_down_sync(FULL, above, off);
+                for (int off = 16; off > 0; off >>= 1) {
+                    above += __shfl_down_sync(FULL, above, off);
+                    after += __shfl_down_sync(FULL, after, off);
+                }
                 if (lane == 0) {
                     slot[0] = __float_as_uint(v - lse);
-                    slot[1] = above;
+                    slot[1] = above - after;
                 }
             }
             __syncthreads();  // part_i is the selection rounds' scratch below
