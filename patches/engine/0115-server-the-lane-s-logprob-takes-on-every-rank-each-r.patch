+    /// The lane's logprob-row take (cuda_lanes takeRows) on every rank: the whole rows its kernels score are
+    /// gathered again, so the other ranks join each gather in the same order. `kind` 0 gathers the verify block's
+    /// first `rows` rows, 1 the shared block's parts (`parts` rows each, in part order), 2 the prompt's last row.
+    /// Rank 0 alone reads the words.
+    pub fn logprobTake(x: Leader, kind: u32, n: u32, parts: []const u32) !void {
+        try x.flush();
+        try x.send(.{ .kind = @backingInt(Kind.logprob), .flags = kind, .a = n }, parts);
+    }
+
     /// The other ranks hear the keep with rank 0's next step (Link.keep_flag), or alone before any other step.
     pub fn keep(x: Leader, n: usize) !void {
         try x.flush();
@@ -418,7 +427,7 @@ pub fn apply(e: *Engine, link: *Link, h_in: Header, ids_in: []const u32, s: *Scr
         try e.keep((h.flags >> 16) & 0xff);
         h.flags &= 0xffff;
     }
-    if (kind != .end and kind != .drop and kind != .shared and kind != .block and kind != .many and kind != .idle and kind != .snapshots and kind != .pool and kind != .disk and kind != .layout) try e.bind(h.slot);
+    if (kind != .end and kind != .drop and kind != .shared and kind != .block and kind != .many and kind != .idle and kind != .snapshots and kind != .pool and kind != .disk and kind != .layout and kind != .logprob) try e.bind(h.slot);
     e.prompt_logprobs = if (promptRows(h)) .{} else null;
     e.structured = structuredStep(h); // rank 0 alone masks them
     switch (kind) {
@@ -502,6 +511,22 @@ pub fn apply(e: *Engine, link: *Link, h_in: Header, ids_in: []const u32, s: *Scr
         .snapshots => _ = try @import("cuda_snapshots.zig").agreeTiers(e, h.a, h.seed),
         .disk => try @import("cuda_disk_ranks.zig").step(e, link, h, ids_in),
         .layout => try checkLayout(e, h.a),
+        .logprob => { // the lane's logprob-row take: this rank's columns join its gathers, rank 0 alone reads them
+            const local = e.share.vocab.len();
+            switch (h.flags) {
+                0 => try e.smp.gather(e.stream, e.exchange(), e.spans, &.{.{ .rank = e.share.rank, .logits = e.bd.logits }}, @intCast(h.a), e.smp.full.ptr),
+                1 => {
+                    const b = e.bs orelse return error.NoSharedWindows;
+                    var at: usize = 0;
+                    for (ids_in) |rows| {
+                        try e.smp.gather(e.stream, e.exchange(), e.spans, &.{.{ .rank = e.share.rank, .logits = b.logits + at * local * 2 }}, @intCast(rows), e.smp.full.ptr);
+                        at += rows;
+                    }
+                },
+                2 => try e.smp.gather(e.stream, e.exchange(), e.spans, &.{.{ .rank = e.share.rank, .logits = e.bp.logits }}, 1, e.smp.full.ptr),
+                else => return error.BadStep,
+            }
+        },
         .drop => for (ids_in) |id| e.dropState(id),
         .release => e.release(h.slot),
         .idle => cuda.tp_watch.sleep(e.io),
