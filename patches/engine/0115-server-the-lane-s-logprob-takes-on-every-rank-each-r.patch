+test "the build facts name the release and backend, hex the tokenizer digest and take the model's dtype and rope" {
+    const io = std.testing.io;
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data =
+        \\{"text_config":{"dtype":"bfloat16","rope_theta":10000,"rope_scaling":{"rope_type":"yarn","factor":16,"original_max_position_embeddings":65536}},"quantization_config":{"quant_method":"exl3","bits":4}}
+    });
+    try tmp.dir.writeFile(io, .{ .sub_path = "tokenizer.json", .data = "[]" });
+    try tmp.dir.writeFile(io, .{ .sub_path = "tokenizer_config.json", .data =
+        \\{"tokenizer_class":"TokenizersBackend","model_max_length":8}
+    });
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", a);
+    var engine: Idle = .{};
+    var text: Bytes = .{};
+    const identity = build_identity.of(WithGpu, a, "9.8.7", 1);
+    const srv = try server.Server.init(std.testing.allocator, io, engine.engine(), text.text(), .{
+        .served_name = "m",
+        .model_ids = &.{"m"},
+        .model_dir = dir,
+        .identity = identity,
+        .kv_cache = "fp8",
+        .tensor_parallel = 2,
+    }, null);
+    defer srv.deinit();
+    const b = srv.build.?.object;
+    try std.testing.expectEqualStrings("9.8.7", b.get("engine_version").?.string);
+    try std.testing.expectEqualStrings("cuda", b.get("backend").?.string);
+    try std.testing.expect(b.get("git_commit") == null and b.get("patches") == null); // a plain build records neither
+    try std.testing.expectEqualStrings("bfloat16", b.get("compute_dtype").?.string);
+    try std.testing.expectEqual(@as(i64, 10000), b.get("rope_theta").?.int64().?);
+    try std.testing.expectEqual(@as(i64, 65536), b.get("rope_scaling").?.object.get("original_max_position_embeddings").?.int64().?);
+    try std.testing.expectEqual(@as(i64, 65536), b.get("rope_original_context").?.int64().?);
+    try std.testing.expectEqualStrings("TokenizersBackend", b.get("tokenizer_name").?.string);
+    const sha = b.get("tokenizer_sha256").?.string;
+    try std.testing.expectEqual(@as(usize, 64), sha.len);
+    for (sha) |c| try std.testing.expect((c >= '0' and c <= '9') or (c >= 'a' and c <= 'f'));
+}
