From a8265c10c5e3d7ccfd06b8761c69655c53972f3f Mon Sep 17 00:00:00 2001
From: Mia's AI Lab <mia@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:12:22 +0200
Subject: [PATCH] server: a request may hold up to 100 images

The --vision-max-images bound was 1 to 64; a request with 51 pictures
(screenshots pasted beside a session's earlier attachments, say) was
refused before the tower saw it. The bound is now 100, and Qwen-VL's
M-RoPE layout (whose span table is sized by the same bound) follows it,
so no family accepts a flag its rows then refuse. The per-image token
budgets still bound a request's rows.
---
 zig/src/core/qwen_vl/rope.zig | 2 +-
 zig/src/server/cli.zig        | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/zig/src/core/qwen_vl/rope.zig b/zig/src/core/qwen_vl/rope.zig
index 08e483fba..117c08260 100644
--- a/zig/src/core/qwen_vl/rope.zig
+++ b/zig/src/core/qwen_vl/rope.zig
@@ -2,7 +2,7 @@
 const std = @import("std");
 
 /// Images one request holds at most (the server's --vision-max-images bound).
-pub const max_images = 64;
+pub const max_images = 100;
 
 /// One image's rows from `at`: `rows` x `cols` merged places, all at text position `base` plus their row and column.
 pub const Span = struct { at: u32, rows: u32, cols: u32, base: i32 };
diff --git a/zig/src/server/cli.zig b/zig/src/server/cli.zig
index 337ac7251..404071638 100644
--- a/zig/src/server/cli.zig
+++ b/zig/src/server/cli.zig
@@ -434,7 +434,7 @@ fn apply(a: Allocator, out: *Args, name: []const u8, value: ?[]const u8, u: *Usa
         out.compact_keep = @intCast(n);
     } else if (is(name, "--compact-memory")) out.compact_memory = v else if (is(name, "--slide")) out.slide = true else if (is(name, "--slide-graph")) out.slide_graph = v else if (is(name, "--parallel")) out.parallel = v else if (is(name, "--backend")) out.backend = v else if (is(name, "--cortheon")) out.cortheon = true else if (is(name, "--vision")) out.vision = true else if (is(name, "--vision-urls")) out.vision_urls = true else if (is(name, "--vision-max-images")) {
         const n = try int(u, a, name, v);
-        if (n < 1 or n > 64) return fail(u, a, "argument --vision-max-images: expected 1 to 64 images: '{s}'", .{v});
+        if (n < 1 or n > 100) return fail(u, a, "argument --vision-max-images: expected 1 to 100 images: '{s}'", .{v});
         out.vision_max_images = @intCast(n);
     } else if (is(name, "--vision-max-videos")) {
         const n = try int(u, a, name, v);
-- 
