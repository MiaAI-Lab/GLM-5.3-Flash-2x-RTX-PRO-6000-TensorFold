diff --git a/zig/src/server/extra_eos.zig b/zig/src/server/extra_eos.zig
new file mode 100644
index 000000000..c69b24c57
--- /dev/null
+++ b/zig/src/server/extra_eos.zig
@@ -0,0 +1,52 @@
+//! TF_EXTRA_EOS: a comma-separated list of the tokenizer's tokens (by their text, e.g. `<|assistant|>`) that end a reply
+//! like the checkpoint's own EOS ids, added after them. A checkpoint whose generation_config leaves out a turn opener
+//! the model can write (GLM-5.3: `<|assistant|>`) otherwise streams it as text and starts a turn of its own until the
+//! length cap. Unset or empty: the EOS list is the checkpoint's. A name the tokenizer does not hold refuses the start.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// The list TF_EXTRA_EOS asks for, or null when unset.
+pub fn fromEnv() ?[]const u8 {
+    const v = std.c.getenv("TF_EXTRA_EOS") orelse return null;
+    return std.mem.span(v);
+}
+
+/// `base` followed by each token `raw` names that it does not already hold; `unknown` gets the first name not found.
+pub fn merge(a: Allocator, base: []const u32, raw: []const u8, ctx: anytype, comptime tokenId: fn (@TypeOf(ctx), []const u8) ?u32, unknown: *[]const u8) error{ OutOfMemory, UnknownExtraEos }![]const u32 {
+    var out: std.ArrayList(u32) = .empty;
+    errdefer out.deinit(a);
+    try out.appendSlice(a, base);
+    var it = std.mem.splitScalar(u8, raw, ',');
+    while (it.next()) |part| {
+        const name = std.mem.trim(u8, part, " \t");
+        if (name.len == 0) continue;
+        const id = tokenId(ctx, name) orelse {
+            unknown.* = name;
+            return error.UnknownExtraEos;
+        };
+        if (std.mem.indexOfScalar(u32, out.items, id) == null) try out.append(a, id);
+    }
+    return out.toOwnedSlice(a);
+}
+
+const Fake = struct {
+    fn id(_: Fake, name: []const u8) ?u32 {
+        if (std.mem.eql(u8, name, "<|assistant|>")) return 154828;
+        if (std.mem.eql(u8, name, "<|user|>")) return 154827;
+        return null;
+    }
+};
+
+test "extra eos: names add their ids once, after the checkpoint's; an unknown name refuses" {
+    const a = std.testing.allocator;
+    const base = [_]u32{ 154820, 154827, 154829 };
+    var unknown: []const u8 = "";
+    const got = try merge(a, &base, " <|assistant|>, <|user|>,,<|assistant|>", Fake{}, Fake.id, &unknown);
+    defer a.free(got);
+    try std.testing.expectEqualSlices(u32, &.{ 154820, 154827, 154829, 154828 }, got);
+    const same = try merge(a, &base, "", Fake{}, Fake.id, &unknown);
+    defer a.free(same);
+    try std.testing.expectEqualSlices(u32, &base, same);
+    try std.testing.expectError(error.UnknownExtraEos, merge(a, &base, "<|assistant|>,<|nope|>", Fake{}, Fake.id, &unknown));
+    try std.testing.expectEqualStrings("<|nope|>", unknown);
+}
diff --git a/zig/src/server/metrics.zig b/zig/src/server/metrics.zig
index 995550250..1a0a6e9bf 100644
--- a/zig/src/server/metrics.zig
+++ b/zig/src/server/metrics.zig
@@ -237,9 +237,44 @@ pub const Metrics = struct {
         if (snap.phases) try histogram(w, "request_queue_time_seconds", "Seconds a finished request waited before admission, under vLLM's name.", snap.queue);
         try gauge(w, "client_disconnections_total", "counter", "Requests a client left before the reply left the server.", snap.disconnects);
         if (status.preemptions) |p| try gauge(w, "preemptions_total", "counter", "Requests that had to give a lane up to a later one.", p);
+        if (status.kv_parts) |k| try kvShard(w, k);
     }
 };
 
+/// A sharded KV pool's families (GLM's TF_GLM_KV_SHARD): `kv_shard_*` gauges and counters, then each part's pages.
+pub fn kvShard(w: *std.Io.Writer, k: api.Status.KvParts) !void {
+    const S = api.Status.KvParts;
+    inline for (@typeInfo(S).@"struct".field_names) |n| {
+        if (comptime std.mem.eql(u8, n, "part")) continue;
+        const kind = comptime for (S.gauges) |g| {
+            if (std.mem.eql(u8, g, n)) break "gauge";
+        } else "counter";
+        try gauge(w, "kv_shard_" ++ n ++ if (comptime std.mem.eql(u8, kind, "counter")) "_total" else "", kind, @field(S.help, n), @field(k, n));
+    }
+    const P = @TypeOf(k.part[0]);
+    inline for (@typeInfo(P).@"struct".field_names) |n| {
+        try family(w, "kv_shard_part_" ++ n, "gauge", @field(P.help, n));
+        for (k.part[0..@min(k.parts, k.part.len)], 0..) |x, i| try w.print("{s}kv_shard_part_{s}{{part=\"{d}\"}} {d}\n", .{ prefix, n, i, @field(x, n) });
+    }
+}
+
+test "a sharded pool's kv_shard families: gauges, counters with _total, a part label each" {
+    var out: std.Io.Writer.Allocating = .init(std.testing.allocator);
+    defer out.deinit();
+    var k: api.Status.KvParts = .{ .parts = 2, .part_pages = 900, .page_tokens = 512, .owner_layers = 33, .twins_made = 4 };
+    k.part[1] = .{ .free = 12, .live_pages = 400, .twin_pages = 8, .live = 3 };
+    try kvShard(&out.writer, k);
+    const text = out.written();
+    for ([_][]const u8{
+        "# TYPE tensorfold:kv_shard_parts gauge\ntensorfold:kv_shard_parts 2\n",
+        "tensorfold:kv_shard_part_pages 900\n",
+        "# TYPE tensorfold:kv_shard_owner_layers_total counter\ntensorfold:kv_shard_owner_layers_total 33\n",
+        "tensorfold:kv_shard_twins_made_total 4\n",
+        "tensorfold:kv_shard_part_live_pages{part=\"1\"} 400\n",
+        "tensorfold:kv_shard_part_free{part=\"0\"} 0\n",
+    }) |want| try std.testing.expect(std.mem.indexOf(u8, text, want) != null);
+}
+
 fn family(w: *std.Io.Writer, name: []const u8, kind: []const u8, help: []const u8) !void {
     try w.print("# HELP {s}{s} {s}\n# TYPE {s}{s} {s}\n", .{ prefix, name, help, prefix, name, kind });
 }
